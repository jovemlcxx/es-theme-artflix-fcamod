<theme>
   <formatVersion>7</formatVersion>
   <!-- 4:3 (640x480), laid out as fractions of the screen. The base is 16:9: its left text column keeps its proportions (the text is wider here, the screen is taller),
        the vertical carousel of logos stays on the right (5 logos, the selected one 1.3 times bigger) and the buttons are redrawn (images in _inc/images). -->
