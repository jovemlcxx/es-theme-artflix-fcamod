      <batteryIndicator name="batteryIndicator">
         <pos>0.7475 0.9480</pos>
         <size>0.1 0.045</size>
      </batteryIndicator>
      <text name="clock">
         <pos>0.8 0.9480</pos>
         <size>0.17 0.045</size>
         <fontSize>0.03</fontSize>
         <alignment>right</alignment>
      </text>
   </view>

