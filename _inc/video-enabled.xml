<theme>
   <formatVersion>7</formatVersion>
   <!-- Random video of the system ON (the "random-video" subset in theme.xml): a random game video of the system at the bottom left, as in the base's "Default Artflix" -->
   <view name="system">
      <video name="md_video" extra="true">
         <path>{random}</path>
         <pos>0.03 0.725</pos>
         <maxSize>0.30 0.20</maxSize>
         <origin>0 0</origin>
         <delay>0.2</delay>
         <showSnapshotNoVideo>false</showSnapshotNoVideo>
         <showSnapshotDelay>false</showSnapshotDelay>
         <zIndex>50</zIndex>
      </video>
   </view>
</theme>
