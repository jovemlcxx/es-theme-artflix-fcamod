<theme defaultView="grid">
   <formatVersion>7</formatVersion>
   <!-- ARTFLIX for the R36S and clones (EmulationStation-fcamod, 640x480): a fork of "Alekfull ARTFLIX" by fagnerpc (https://github.com/fagnerpc/Alekfull-ARTFLIX, made for
        Batocera / RetroBat), cut down to the two screens the R36S needs: the Netflix-like system view (the system's art as the background with a dark gradient, big name,
        description, PLAY NOW / games buttons, a random video of the system and the vertical carousel of logos) and a game list in the same style (a row of covers
        made of the game's image with its wheel over it, the selected game's cover, text and image / video). The base's own art, logos, texts, fonts, buttons and menu. -->
   <variables>
      <fontBlack>./_inc/fonts/Circular Std Black.ttf</fontBlack>
      <fontBook>./_inc/fonts/Circular Std Book.ttf</fontBook>
      <fontLight>./_inc/fonts/OpenSans-Light.ttf</fontLight>
      <fontSemi>./_inc/fonts/OpenSans-Semibold.ttf</fontSemi>
      <fontPlayers>./_inc/fonts/players.ttf</fontPlayers>
      <artsPath>./_inc/arts</artsPath>
      <logosPath>./_inc/logos</logosPath>
      <infoPath>./_inc/info</infoPath>
      <white>ffffff</white>
      <red>f60915</red>
      <grey>a8a8a8</grey>
      <aspectRatioLabel>Aspect Ratio</aspectRatioLabel>
      <playNow>PLAY NOW</playNow>
      <helpMenu>MENU</helpMenu>
      <helpRandom>RANDOM</helpRandom>
      <helpSelect>SELECT</helpSelect>
      <helpChoose>CHOOSE</helpChoose>
      <helpFavorite>FAVORITE</helpFavorite>
      <helpLaunch>LAUNCH</helpLaunch>
      <helpBack>BACK</helpBack>
      <labelManufacturer>MANUFACTURER:</labelManufacturer>
      <labelDeveloper>DEVELOPER:</labelDeveloper>
      <selectedLanguage>Selected Language: EN(US)</selectedLanguage>
   </variables>
   <!-- Translations: one file per language, included only for that language (ES-fcamod stops reading <variables> blocks at the first
        one whose lang does not match, so they cannot all live in this file). They must come before the subsets, whose names use them. -->
   <include lang="pt,br">./_inc/lang/br.xml</include>
   <include lang="es">./_inc/lang/es.xml</include>
   <include lang="fr">./_inc/lang/fr.xml</include>
   <include lang="de">./_inc/lang/de.xml</include>
   <include lang="it">./_inc/lang/it.xml</include>
   <include lang="ja">./_inc/lang/ja.xml</include>
   <include lang="ko">./_inc/lang/ko.xml</include>
   <include lang="ru">./_inc/lang/ru.xml</include>
   <include lang="zh-cn,zh">./_inc/lang/zh-cn.xml</include>
   <include lang="zh-tw">./_inc/lang/zh-tw.xml</include>
   <include lang="tr">./_inc/lang/tr.xml</include>
   <include lang="nl">./_inc/lang/nl.xml</include>
   <include lang="sv">./_inc/lang/sv.xml</include>
   <include lang="pl">./_inc/lang/pl.xml</include>
   <include lang="ca">./_inc/lang/ca.xml</include>
   <include lang="da">./_inc/lang/da.xml</include>
   <include lang="fi">./_inc/lang/fi.xml</include>
   <include lang="hu">./_inc/lang/hu.xml</include>
   <include lang="no,nb">./_inc/lang/no.xml</include>
   <include lang="ro">./_inc/lang/ro.xml</include>
   <include lang="uk,ua">./_inc/lang/uk.xml</include>
   <include lang="cs">./_inc/lang/cs.xml</include>
   <include lang="el">./_inc/lang/el.xml</include>
   <include lang="vi">./_inc/lang/vi.xml</include>
   <include lang="pt">./_inc/lang/pt.xml</include>
   <include lang="id">./_inc/lang/id.xml</include>
   <subset name="aspect-ratio" displayName="${aspectRatioLabel}">
      <include name="4-3" displayName="4:3" />
   </subset>

   <!-- navigation sounds: the base's own (scroll01) -->
   <view name="system, grid, menu">
      <sound name="scroll">
         <path>./_inc/sounds/scroll01.wav</path>
      </sound>
      <sound name="systembrowse">
         <path>./_inc/sounds/scroll01.wav</path>
      </sound>
   </view>

   <!-- clock, bottom right, and the battery next to it (the base shows only the clock; a handheld needs the battery) -->
   <view name="screen">
      <text name="clock">
         <fontPath>${fontBook}</fontPath>
         <color>${white}</color>
         <alignment>right</alignment>
         <verticalAlignment>center</verticalAlignment>
      </text>
      <batteryIndicator name="batteryIndicator">
         <color>${white}</color>
      </batteryIndicator>
   </view>

   <!-- the base's menu: red titles, light grey text, red selector with a gradient, OPAQUE dark frame (the base's frame is 85 % opaque: the system art and its texts showed through and the menu could not be read) -->
   <view name="menu">
      <menuText name="menutitle">
         <fontPath>${fontSemi}</fontPath>
         <fontSize>0.04</fontSize>
         <color>f01e29</color>
      </menuText>
      <menuText name="menufooter">
         <fontPath>${fontLight}</fontPath>
         <fontSize>0.023</fontSize>
         <color>a8a8a8</color>
      </menuText>
      <menuText name="menutext">
         <fontPath>${fontBook}</fontPath>
         <fontSize>0.029</fontSize>
         <color>bdbdbd</color>
         <separatorColor>191919</separatorColor>
         <selectorColor>d90f1a</selectorColor>
         <selectorColorEnd>f60915</selectorColorEnd>
         <selectedColor>FFFFFF</selectedColor>
         <selectorGradientType>horizontal</selectorGradientType>
      </menuText>
      <menuTextSmall name="menutextsmall">
         <fontPath>${fontBook}</fontPath>
         <fontSize>0.022</fontSize>
         <color>e0343d</color>
      </menuTextSmall>
      <menuBackground name="menubg">
         <color>0a0b0c</color>
         <cornerSize>32 32</cornerSize>
         <path>./_inc/frame-opaque.png</path>
      </menuBackground>
      <menuIcons name="menuicons">
         <iconKodi>./_inc/icons/Kodi.png</iconKodi>
         <iconSystem>./_inc/icons/System.png</iconSystem>
         <iconUpdates>./_inc/icons/Updates.png</iconUpdates>
         <iconGames>./_inc/icons/Games.png</iconGames>
         <iconControllers>./_inc/icons/Controllers.png</iconControllers>
         <iconUI>./_inc/icons/UI.png</iconUI>
         <iconSound>./_inc/icons/Sound.png</iconSound>
         <iconNetwork>./_inc/icons/Network.png</iconNetwork>
         <iconScraper>./_inc/icons/Scraper.png</iconScraper>
         <iconAdvanced>./_inc/icons/Advanced.png</iconAdvanced>
         <iconQuit>./_inc/icons/Quit.png</iconQuit>
         <iconRestart>./_inc/icons/Restart.png</iconRestart>
         <iconShutdown>./_inc/icons/Shutdown.png</iconShutdown>
         <iconFastShutdown>./_inc/icons/Fastshutdown.png</iconFastShutdown>
         <iconRetroachievements>./_inc/icons/Contest.png</iconRetroachievements>
         <iconEmuelec>./_inc/icons/Emuelec.png</iconEmuelec>
      </menuIcons>
      <menuTextEdit name="menutextedit">
         <inactive>./_inc/textinput_ninepatch.png</inactive>
         <active>./_inc/textinput_ninepatch_active.png</active>
      </menuTextEdit>
   </view>

   <!-- ===== SYSTEM VIEW (the base's "Default Artflix") =====
        The system's art is the background, the dark gradient over it, then the texts and the buttons. The text of the system (name, year, manufacturer, description)
        comes from _inc/info/<system>.xml, included for every system (a system without that file shows its own name). -->
   <view name="system">
      <image name="e_art_default" extra="true">
         <path>./_inc/images/art-generic.jpg</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>0</zIndex>
      </image>
      <image name="art" extra="true">
         <path>${artsPath}/${system.theme}.jpg</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>1</zIndex>
      </image>
      <image name="e_gradient" extra="true">
         <path>./_inc/images/overlay-gradient.png</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>41</zIndex>
      </image>
      <image name="e_artflix" extra="true">
         <path>./_inc/images/artflix-logo.png</path>
         <zIndex>42</zIndex>
      </image>
      <text name="info6" extra="true">
         <text>${selectedLanguage}</text>
         <fontPath>${fontBook}</fontPath>
         <color>9b9b9b</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <!-- defaults for a system with no info file: its name; the files below replace them -->
      <text name="info2" extra="true">
         <text>${system.fullName}</text>
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>top</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <lineSpacing>1</lineSpacing>
         <glowColor>00000006</glowColor>
         <glowSize>1</glowSize>
         <glowOffset>2</glowOffset>
         <zIndex>42</zIndex>
      </text>
      <text name="info1" extra="true">
         <fontPath>${fontBook}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>top</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <lineSpacing>1.05</lineSpacing>
         <glowColor>00000016</glowColor>
         <glowSize>1</glowSize>
         <zIndex>42</zIndex>
      </text>
      <text name="info3" extra="true">
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <text name="info5" extra="true">
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <text name="info4" extra="true">
         <fontPath>${fontBook}</fontPath>
         <color>${grey}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <text name="e_bar" extra="true">
         <text>|</text>
         <fontPath>${fontBook}</fontPath>
         <color>${white}</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
         <zIndex>42</zIndex>
      </text>
      <image name="e_btn_play" extra="true">
         <path>./_inc/images/btn-play.png</path>
         <zIndex>42</zIndex>
      </image>
      <image name="e_btn_games" extra="true">
         <path>./_inc/images/btn-outline.png</path>
         <zIndex>42</zIndex>
      </image>
      <text name="playbutton" extra="true">
         <text>${playNow}</text>
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>true</forceUppercase>
         <zIndex>43</zIndex>
      </text>
      <text name="systemInfo">
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>true</forceUppercase>
         <zIndex>43</zIndex>
      </text>
      <!-- the vertical carousel of logos at the right: the selected one is the big one in the middle -->
      <carousel name="systemcarousel">
         <type>vertical</type>
         <color>00000000</color>
         <logoScale>1.3</logoScale>
         <logoAlignment>right</logoAlignment>
         <defaultTransition>instant</defaultTransition>
         <scrollSound>./_inc/sounds/scroll01.wav</scrollSound>
         <zIndex>50</zIndex>
      </carousel>
      <image name="logo">
         <path>${logosPath}/${system.theme}.png</path>
      </image>
      <text name="logoText">
         <fontPath>${fontBlack}</fontPath>
         <color>${white}</color>
         <forceUppercase>false</forceUppercase>
      </text>
   </view>
   <include>./_inc/info/${system.theme}.xml</include>

   <!-- ===== GAME LIST (the base's "Fanart Cover View Detailed": a row of covers at the bottom, the selected game's cover, text and image / video above) ===== -->
   <view name="grid">
      <image name="e_art_default" extra="true">
         <path>./_inc/images/art-generic.jpg</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>0</zIndex>
      </image>
      <image name="art" extra="true">
         <path>${artsPath}/${system.theme}.jpg</path>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>1</zIndex>
      </image>
      <image name="e_dim" extra="true">
         <path>./_inc/images/white.png</path>
         <color>000000c4</color>
         <pos>0 0</pos>
         <size>1 1</size>
         <zIndex>15</zIndex>
      </image>
      <image name="e_artflix" extra="true">
         <path>./_inc/images/artflix-logo.png</path>
         <zIndex>42</zIndex>
      </image>
      <image name="e_pad" extra="true">
         <path>./_inc/images/gamepad.svg</path>
         <color>b4b4b4</color>
         <zIndex>42</zIndex>
      </image>
      <!-- the game's image is the background of the whole screen too (dimmed); the system's art only shows for a game without an image -->
      <image name="md_image">
         <origin>0.5 0.5</origin>
         <pos>0.5 0.5</pos>
         <minSize>1 1</minSize>
         <zIndex>5</zIndex>
      </image>
      <!-- the game's video (when it has one) fills the background the same way, a few seconds after the game is selected; until then the image stays -->
      <video name="md_video">
         <origin>0.5 0.5</origin>
         <pos>0.5 0.5</pos>
         <minSize>1 1</minSize>
         <delay>3</delay>
         <showSnapshotNoVideo>false</showSnapshotNoVideo>
         <showSnapshotDelay>false</showSnapshotDelay>
         <zIndex>6</zIndex>
      </video>
      <!-- the selected game, at the left: only its wheel (the game's image is already the background) -->
      <image name="md_marquee">
         <zIndex>36</zIndex>
      </image>
      <text name="md_name">
         <fontPath>${fontBook}</fontPath>
         <color>${white}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>true</forceUppercase>
         <singleLineScroll>false</singleLineScroll>
         <glowColor>00000056</glowColor>
         <glowSize>1</glowSize>
         <zIndex>42</zIndex>
      </text>
      <text name="md_description">
         <fontPath>${fontBook}</fontPath>
         <color>f5f5f5</color>
         <alignment>left</alignment>
         <verticalAlignment>top</verticalAlignment>
         <lineSpacing>1.12</lineSpacing>
         <glowColor>00000066</glowColor>
         <glowSize>1</glowSize>
         <zIndex>42</zIndex>
      </text>
      <text name="md_developer">
         <fontPath>${fontBook}</fontPath>
         <color>${grey}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <text name="md_genre">
         <fontPath>${fontBook}</fontPath>
         <color>${grey}</color>
         <alignment>left</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <zIndex>42</zIndex>
      </text>
      <datetime name="md_releasedate">
         <fontPath>${fontBook}</fontPath>
         <color>${grey}</color>
         <alignment>left</alignment>
         <format>%Y</format>
         <zIndex>42</zIndex>
      </datetime>
      <text name="md_players">
         <fontPath>${fontBlack}</fontPath>
         <color>D0D0D0</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
         <zIndex>42</zIndex>
      </text>
      <rating name="md_rating">
         <filledPath>./_inc/images/star.png</filledPath>
         <unfilledPath>./_inc/images/star-empty.png</unfilledPath>
         <color>f60915</color>
         <unfilledColor>5a5a5a</unfilledColor>
         <zIndex>42</zIndex>
      </rating>
      <!-- the base's column of icons at the left edge: manual, save state, achievements (dim: ES-fcamod has no data for them), the gamepad with the number of players and the rating -->
      <image name="e_i_manual" extra="true">
         <path>./_inc/icons/book.png</path>
         <color>80808090</color>
         <zIndex>42</zIndex>
      </image>
      <image name="e_i_save" extra="true">
         <path>./_inc/icons/SaveState.png</path>
         <color>80808090</color>
         <zIndex>42</zIndex>
      </image>
      <image name="e_i_cheevos" extra="true">
         <path>./_inc/icons/Contest.png</path>
         <color>80808090</color>
         <zIndex>42</zIndex>
      </image>
      <image name="e_i_players" extra="true">
         <path>./_inc/images/gamepad.svg</path>
         <color>D0D0D0</color>
         <zIndex>42</zIndex>
      </image>
      <!-- some forks draw the system logo / name as a header on the game list: keep them off screen -->
      <image name="logo">
         <pos>2 2</pos>
      </image>
      <text name="logoText">
         <pos>2 2</pos>
      </text>
      <!-- the row of covers: the game's image with its wheel over it; the selected cover is a little bigger, with the red outline -->
      <imagegrid name="gamegrid">
         <scrollDirection>horizontal</scrollDirection>
         <imageSource>image</imageSource>
         <gameImage>./_inc/images/cover-plate.png</gameImage>
         <folderImage>./_inc/images/cover-plate.png</folderImage>
         <autoLayoutSelectedZoom>1.06</autoLayoutSelectedZoom>
         <showVideoAtDelay>-1</showVideoAtDelay>
         <scrollSound>./_inc/sounds/scroll01.wav</scrollSound>
         <zIndex>60</zIndex>
      </imagegrid>
      <gridtile name="default">
         <imageSizeMode>minSize</imageSizeMode>
         <imageColor>808088FF</imageColor>
         <backgroundImage>./_inc/images/cover-plate.png</backgroundImage>
         <backgroundCornerSize>0 0</backgroundCornerSize>
         <backgroundColor>1c1c20ff</backgroundColor>
         <padding>2 2</padding>
      </gridtile>
      <gridtile name="selected">
         <imageSizeMode>minSize</imageSizeMode>
         <imageColor>FFFFFFFF</imageColor>
         <backgroundImage>./_inc/images/cover-plate.png</backgroundImage>
         <backgroundCornerSize>0 0</backgroundCornerSize>
         <backgroundColor>1c1c20ff</backgroundColor>
         <padding>2 2</padding>
      </gridtile>
      <image name="gridtile.image">
         <pos>0.5 0.5</pos>
         <origin>0.5 0.5</origin>
      </image>
      <!-- the red frame over the selected cover (over the image: a background would be hidden by it) -->
      <image name="gridtile.overlay">
         <path>./_inc/images/cover-frame.png</path>
         <pos>0.5 0.5</pos>
         <origin>0.5 0.5</origin>
         <size>1 1</size>
         <color>00000000</color>
      </image>
      <image name="gridtile.overlay:selected">
         <color>f60915ff</color>
      </image>
      <image name="gridtile.marquee">
         <pos>0.5 0.74</pos>
         <origin>0.5 0.5</origin>
         <size>0.9 0.9</size>
         <color>dadadaff</color>
      </image>
      <image name="gridtile.marquee:selected">
         <pos>0.5 0.74</pos>
         <origin>0.5 0.5</origin>
         <size>0.9 0.9</size>
         <color>FFFFFFFF</color>
      </image>
      <text name="gridtile">
         <visible>false</visible>
         <singleLineScroll>false</singleLineScroll>
      </text>
   </view>

   <include>./_inc/legend.xml</include>
   <include subset="aspect-ratio" name="4-3">./aspect-ratio-4-3.xml</include>
</theme>
